// Unlock milestones — one per non-person tier. Each predicate is an
// archive-style conjunction over world_drafts and archived/pinned counts.
// unlock-household counts ARCHIVED persons, not pins: the roster is seeded
// by graduation itself and the person bench holds one pin at most, so the
// gate must be reachable before any roster exists.
// Operand policy (Phase 3): every kind past person ships `pinnable: false`
// and pins/focus stay person/place, so org→region gates count ARCHIVED
// cards — provably reachable at every scale (household harvests produce
// tradition cards, org harvests produce charter, and so on).
{
  milestones: [
    {
      schema_version: 'milestone/v0',
      id: 'unlock-household',
      predicate: {
        op: 'and',
        operands: [
          { op: 'gte', key: 'world_drafts.total', value: 1 },
          { op: 'gte', key: 'archived.person', value: 3 },
        ],
      },
      grants: { tier: 'household', ceremony_sid: 'graduation.household' },
    },
    {
      schema_version: 'milestone/v0',
      id: 'unlock-org',
      predicate: {
        op: 'and',
        operands: [
          { op: 'gte', key: 'archived.tradition', value: 2 },
          { op: 'gte', key: 'world_drafts.household', value: 1 },
        ],
      },
      grants: { tier: 'org', ceremony_sid: 'graduation.org' },
    },
    {
      schema_version: 'milestone/v0',
      id: 'unlock-town',
      predicate: {
        op: 'and',
        operands: [
          { op: 'gte', key: 'archived.charter', value: 1 },
          { op: 'gte', key: 'world_drafts.org', value: 2 },
        ],
      },
      grants: { tier: 'town', ceremony_sid: 'graduation.town' },
    },
    {
      schema_version: 'milestone/v0',
      id: 'unlock-city',
      predicate: {
        op: 'and',
        operands: [
          { op: 'gte', key: 'archived.festival', value: 1 },
          { op: 'gte', key: 'archived.landmark', value: 1 },
          { op: 'gte', key: 'world_drafts.town', value: 2 },
        ],
      },
      grants: { tier: 'city', ceremony_sid: 'graduation.city' },
    },
    {
      schema_version: 'milestone/v0',
      id: 'unlock-region',
      predicate: {
        op: 'and',
        operands: [
          { op: 'gte', key: 'archived.institution', value: 1 },
          { op: 'gte', key: 'archived.monument', value: 1 },
          { op: 'gte', key: 'world_drafts.city', value: 2 },
        ],
      },
      grants: { tier: 'region', ceremony_sid: 'graduation.region' },
    },
  ],
}
