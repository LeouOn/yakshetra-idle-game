// Kind registry rows. Order is load-bearing — mirrors DEFAULT_KIND_RULES
// in @/engine/kind-registry. The loader flattens these rows into KindRule
// objects on package load; the loader test asserts deep equality.
{
  kinds: [
    {
      schema_version: 'kind/v0',
      id: 'change',
      scale: 'person',
      pinnable: false,
      catalog_ref: 'core/change',
      sid_ns: 'kind.change',
      min_quality: 0,
      match: { dominant: 'practice_level' },
    },
    {
      schema_version: 'kind/v0',
      id: 'outcome',
