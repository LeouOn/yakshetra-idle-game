  // ──────────────────────────────────────────────────────────────────────
  // Visitor tables (Phase 4 Task 2). A visitor row with `table_ref` swaps
  // the tier's kind catalog for the whole pool of entries living under
  // that namespace. Ship one namespace; no visitor carries `table_ref`
  // today, so the runtime swap is a future-hook, but the data shape must
  // exist for the loader test and the swap unit test to drive. The
  // entries use names that NEVER appear in the per-kind tables, so the
  // a swap is observable in the harvested manifest name.
  // ──────────────────────────────────────────────────────────────────────
  visitor_tables: {
    'visitor-table/sample-arrival': [
