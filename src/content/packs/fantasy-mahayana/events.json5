{
  // Fantasy Mahayana event graph (plan todo 22).
  //
  // The Garden and its Gardener are original allegorical fiction. The scenes
  // name disorientation and anguish without graphic detail. Nuanced motives
  // remain narrative cards while the engine records one canonical intent root
  // per choice for cross-life echo analysis.
  events: [
    // -----------------------------------------------------------------------
    // 1. The Gardener asks what the arriving soul carries.
    // -----------------------------------------------------------------------
    {
      id: 'event:fantasy/gardener-question',
      weight: 1.0,
      cooldown_turns: 1,
      once_per_run: false,
      content_warnings: ['loss-of-memory'],
      situation_sid: 'event.fantasy.gardener-question.situation_sid',
      choices: [
        {
          id: 'name-a-grief',
          label_sid: 'event.fantasy.gardener-question.hint.name-a-grief_sid',
          outcome_sid: 'event.fantasy.gardener-question.name-a-grief.outcome_sid',
          journal_sid: 'event.fantasy.gardener-question.name-a-grief.journal_sid',
          requires: [],
          effects: [
            { op: 'remove_flag', key: 'attachment:memory' },
            { op: 'add_flag', key: 'attachment:memory:cleared' },
            { op: 'set_intent_root', intent_root: 'care' },
          ],
          forbidden: false,
        },
        {
          id: 'refuse-to-name',
          label_sid: 'event.fantasy.gardener-question.hint.refuse-to-name_sid',
          outcome_sid: 'event.fantasy.gardener-question.refuse-to-name.outcome_sid',
          journal_sid: 'event.fantasy.gardener-question.refuse-to-name.journal_sid',
          requires: [],
          effects: [
            { op: 'add_flag', key: 'attachment:memory' },
            { op: 'set_intent_root', intent_root: 'aversion' },
          ],
          forbidden: false,
        },
        {
          id: 'name-a-joy',
          label_sid: 'event.fantasy.gardener-question.hint.name-a-joy_sid',
          outcome_sid: 'event.fantasy.gardener-question.name-a-joy.outcome_sid',
          journal_sid: 'event.fantasy.gardener-question.name-a-joy.journal_sid',
          requires: [],
          effects: [
            { op: 'remove_flag', key: 'attachment:memory' },
            { op: 'add_flag', key: 'attachment:memory:cleared' },
            { op: 'add_flag', key: 'appreciation:remembered-joy' },
            { op: 'set_intent_root', intent_root: 'care' },
          ],
          forbidden: false,
        },
      ],
    },

