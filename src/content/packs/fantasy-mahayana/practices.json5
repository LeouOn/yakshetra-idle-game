{
  // Fantasy Mahayana idle-mode practices — original allegorical activities
  // tied to the six parami-inspired lenses.
  //
  // Same representation fence as the rest of the pack: no named sacred
  // figures, no mantras, no doctrinal claims. The Gardener is an original
  // allegorical figure, not a disguised sacred being.
  //
  // Every practice carries one `set_intent_root` effect so the engine's
  // cross-life echo reducer records a canonical intent root for each tick
  // of progress. The root is always 'care' for these contemplative
  // activities — they are tending, listening, walking, watching, never
  // grasping or averting.

  practices: [
    // ──────────────────────────────────────────────────────────────────────
    // 1. Garden tending — careful conduct. Mindful work in the Garden's
    // living hedge; small trust gain per tick.
    // ──────────────────────────────────────────────────────────────────────
    {
      id: 'practice:fantasy/garden-tending',
      label_sid: 'fantasy.practice.garden_tending.label_sid',
      description_sid: 'fantasy.practice.garden_tending.description_sid',
      lens: 'careful_conduct',
      progressPerTick: 0.4,
      maxProgress: 10,
      effects: [
        { op: 'add_resource', key: 'trust', delta: 1 },
        { op: 'set_intent_root', intent_root: 'care' },
      ],
    },

    // ──────────────────────────────────────────────────────────────────────
